# Copy this file to .env.local (git-ignored) for local development.
# Gemini API key used by the AI chat (/api/qa-chat) and the translate button (/api/translate).
# Create one at https://aistudio.google.com/apikey
# On Netlify, set the same variable in Site configuration → Environment variables.
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-4-hydrogen)
# GEMINI_MODEL=
