# Copy this file to .env.local (git-ignored) for local development.
# Gemini API key used by the AI chat (/api/qa-chat) and the translate button (/api/translate).
# Create one at https://aistudio.google.com/apikey
# On Netlify, set the same variable in Site configuration → Environment variables.
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-4-hydrogen)
# GEMINI_MODEL=
# Optional: a model to try first when the main one is unavailable (otherwise the app picks one the key can use)
# GEMINI_FALLBACK_MODEL=

# AI chat answered by Claude on the VPS instead of Gemini (see poller/README.md):
# AI_PROVIDER=claude-vps
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   (the whole JSON, one line)
# AI_DAILY_TURNS=400
