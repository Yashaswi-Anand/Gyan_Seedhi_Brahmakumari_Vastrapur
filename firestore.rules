rules_version = '2';

// Gyan Seedhi – Cloud Firestore security rules.
//
// The app has no sign-in: the teacher is recognised in the app by mobile number.
// So these rules cannot tell WHO is writing; they make sure every write has the
// right shape, and that a student's result for a day can't be changed once saved.
// To truly lock question editing to the teacher, add Firebase Authentication later
// and require it in the questions rules below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isDateKey(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function isText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optText(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function isIntIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }

    // one language version of a question inside i18n (hi / en / gu)
    function validVersion(v) {
      return v is map
        && v.keys().hasOnly(['q', 'opts', 'hint', 'exp', 'title'])
        && isText(v.q, 1000)
        && optText(v, 'hint', 500)
        && optText(v, 'exp', 1000)
        && optText(v, 'title', 120)
        && (!('opts' in v) || (v.opts is list && v.opts.size() <= 4));
    }
    function validI18n(d) {
      return !('i18n' in d)
        || (d.i18n is map
            && d.i18n.keys().hasOnly(['hi', 'en', 'gu'])
            && (!('hi' in d.i18n) || validVersion(d.i18n.hi))
            && (!('en' in d.i18n) || validVersion(d.i18n.en))
            && (!('gu' in d.i18n) || validVersion(d.i18n.gu)));
    }

    // questions/{id}: one question for one date (published == false means a draft students don't see)
    function validQuestion(d) {
      return d.keys().hasOnly(['date', 'category', 'q', 'opts', 'ans', 'hint', 'exp', 'tag', 'title', 'i18n', 'published', 'order', 'createdAt', 'updatedAt'])
        && validI18n(d)
        && (!('published' in d) || d.published is bool)
        && isDateKey(d.date)
        && d.category in ['murli', 'chart']
        && isText(d.q, 1000)
        && optText(d, 'hint', 500)
        && optText(d, 'exp', 1000)
        && optText(d, 'tag', 60)
        && optText(d, 'title', 120)
        && (d.category == 'chart'
            || (d.opts is list && d.opts.size() >= 2 && d.opts.size() <= 4 && isIntIn(d.ans, 0, d.opts.size() - 1)))
        && (!('order' in d) || d.order is number);
    }

    // results/{mobile}_{date}: a student's saved result for one day
    function validResult(d, id) {
      return d.keys().hasOnly(['mobile', 'name', 'date', 'points', 'mPts', 'cPts', 'mMax', 'cMax', 'acc', 'first', 'total', 'timeSec', 'createdAt'])
        && d.mobile is string && d.mobile.matches('[6-9][0-9]{9}')
        && isText(d.name, 60)
        && isDateKey(d.date)
        && id == d.mobile + '_' + d.date
        && isIntIn(d.points, 0, 2000)
        && isIntIn(d.mPts, 0, 2000)
        && isIntIn(d.cPts, 0, 2000)
        && isIntIn(d.acc, 0, 100)
        && isIntIn(d.timeSec, 0, 86400);
    }

    match /questions/{id} {
      allow read: if true;
      allow create, update: if validQuestion(request.resource.data);
      allow delete: if true;
    }

    match /results/{id} {
      allow read: if true;
      allow create: if validResult(request.resource.data, id);
      allow update, delete: if false; // the first attempt of the day is final
    }
  }
}
